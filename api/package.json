{
  "name": "ember-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "playwright:install": "node ./scripts/playwright-install.mjs",
    "playwright:check": "node ./scripts/playwright-check.mjs",
    "playwright:bundle-linux-libs": "bash ./scripts/playwright-bundle-linux-libs.sh",
    "test:forms-hub-context": "node --import tsx --test ./tests/formsHubContext.test.ts",
    "test:follow-up-classification": "node --import tsx --test ./tests/followUpClassification.test.ts",
    "test": "node --import tsx --test ./tests/formsHubContext.test.ts ./tests/followUpClassification.test.ts ./tests/answerKeys.test.ts ./tests/parentInstanceGuard.test.ts ./tests/calculationFields.test.ts ./tests/kamSclPoc.test.ts ./tests/roleGate.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run test",
    "test:answer-keys": "node --import tsx --test ./tests/answerKeys.test.ts",
    "test:parenting": "node --import tsx --test ./tests/parentInstanceGuard.test.ts",
    "test:calculation-fields": "node --import tsx --test ./tests/calculationFields.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.26.0",
    "applicationinsights": "^3.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "mssql": "^12.2.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "tedious": "^19.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^25.0.10",
    "cross-env": "^10.1.0",
    "survey-core": "^2.5.41",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
