# src/api/.env.example
# local dev only; don't commit /api/.env
DB_AUTH=sql
SQL_SERVER=ember-sql.database.windows.net
SQL_DATABASE=ember-sql-db

# only for local sql auth
SQL_USER=
SQL_PASSWORD=
NODE_ENV=development
DEV_AUTH=1
DEV_USER_OID=local-dev-user
DEV_USER_EMAIL=
DEV_USER_NAME=
DEV_ROLES=gebruiker,admin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Digitaal Logboek; backend only. Local dev loads the personal DPAPI credential when these remain empty.
# Configure deployed environments through App Service settings or Key Vault.
DIGITAAL_LOGBOEK_BASE_URL=https://www.digitaallogboek.com
DIGITAAL_LOGBOEK_CLIENT_ID=
DIGITAAL_LOGBOEK_CLIENT_SECRET=
DIGITAAL_LOGBOEK_SCOPE=DigitalLog.API.ExternalAccess
