                { "item_code": "VA-06", "onderwerp": "Risico's kenbaar gemaakt aan betrokken medewerkers", "voldoet": "", "opmerking": "" },
                { "item_code": "VA-07", "onderwerp": "Gereedschap en materieel zijn goedgekeurd", "voldoet": "", "opmerking": "" },
                { "item_code": "VA-08", "onderwerp": "Werkplek en materiaal zijn netjes en overzichtelijk", "voldoet": "", "opmerking": "" },
