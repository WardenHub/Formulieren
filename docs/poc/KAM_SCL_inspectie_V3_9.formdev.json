{
  "title": "KAM / SCL-inspectie",
  "description": "Werkzaamheden op locatie. Dit formulier is algemeen; er is geen installatiecontext vereist.",
  "locale": "nl",
  "showProgressBar": "top",
  "progressBarType": "pages",
  "showTOC": true,
  "tocLocation": "right",
  "pagePrevText": "Vorige",
  "pageNextText": "Volgende",
  "completeText": "Indienen voor KAM-beoordeling",
  "checkErrorsMode": "onComplete",
  "pages": [
    {
      "name": "gegevens",
      "title": "Gegevens",
      "elements": [
        { "type": "text", "name": "projectnaam", "title": "Projectnaam", "isRequired": true, "width": "50%" },
        { "type": "text", "name": "datum_inspectie", "title": "Datum inspectie", "inputType": "date", "isRequired": true, "width": "25%" },
        { "type": "text", "name": "projectnummer", "title": "Projectnummer", "width": "25%" },
        { "type": "text", "name": "naam_inspecteur", "title": "Naam inspecteur", "isRequired": true, "width": "50%" },
        { "type": "text", "name": "datum_ontvangst_kam", "title": "Datum ontvangst kwaliteits- en VGM-functionaris", "inputType": "date", "width": "50%" },
        { "type": "comment", "name": "omschrijving_werkzaamheden", "title": "Omschrijving werkzaamheden", "isRequired": true, "rows": 3 },
        { "type": "comment", "name": "aanwezige_medewerkers", "title": "Aanwezige medewerkers", "rows": 3 },
        {
          "type": "radiogroup",
          "name": "lmra_toegepast",
          "title": "LMRA toegepast",
          "isRequired": true,
          "choices": [
            { "value": "Ja", "text": "Ja" },
            { "value": "Nee", "text": "Nee" }
          ]
        }
      ]
    },
    {
      "name": "situatieschets",
      "title": "Situatieschets",
      "description": "Vink aan wat van toepassing is. De bijbehorende controlecategorie wordt alleen getoond wanneer de situatie speelt.",
      "elements": [
        { "type": "boolean", "name": "situatie_verplaatsen", "title": "Materiaal of materieel verplaatsen, laden of lossen" },
        { "type": "boolean", "name": "situatie_alleen_gebouw", "title": "Alleen werken, en/of werken in een gebouw of winkel" },
        { "type": "boolean", "name": "situatie_gereedschap", "title": "Elektrisch of overig handgereedschap gebruiken" },
        { "type": "boolean", "name": "situatie_kabelwerk", "title": "Kabelwerk monteren/demonteren of werken met ionisatie brandmelders" },
        { "type": "boolean", "name": "situatie_nauwe_ruimte", "title": "Werken in een nauwe ruimte, zoals kruipruimte of zolder" },
        { "type": "boolean", "name": "situatie_hoogte", "title": "Werken op hoogte, zoals trap, rolsteiger of hoogwerker" },
