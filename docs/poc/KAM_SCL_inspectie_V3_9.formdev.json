              "columns": [
                { "name": "item_code", "title": "Nr.", "cellType": "text", "readOnly": true, "width": "8%" },
                { "name": "onderwerp", "title": "Controlepunt", "cellType": "text", "readOnly": true, "width": "50%" },
                { "name": "voldoet", "title": "Beoordeling", "cellType": "radiogroup", "isRequired": true, "choices": ["Ja", "Nee", "NVT"], "colCount": 3, "width": "20%" },
                { "name": "opmerking", "title": "Toelichting bij Nee", "cellType": "comment", "width": "22%" }
